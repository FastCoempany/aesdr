# ═══ AESDR environment variables ═══
# Copy to .env.local for local dev. All vars below must ALSO be set in Vercel
# (Settings → Environment Variables) for production.

# ─── Supabase (Database + Auth) ───
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Stripe (Payments) ───
# Test mode for sandbox, prod keys for launch
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_SDR=price_...
STRIPE_PRICE_ID_AE=price_...
STRIPE_PRICE_ID_TEAM=price_...
STRIPE_PRICE_ID_ARTIFACT_UNLOCK=price_...

# ─── Resend (Transactional Email) ───
RESEND_API_KEY=re_...
# Where partner-application notifications go (form submits to this address)
EMAIL_RECIPIENT=affiliates@aesdr.com
# From address on outbound notifications. Domain must be verified in Resend.
EMAIL_FROM=AESDR Affiliates <affiliates@aesdr.com>
# Where the partnership control-tower bright-signal alerts + daily digest land.
# Falls back to EMAIL_RECIPIENT, then a hardcoded admin if unset.
PARTNER_ALERT_EMAIL=affiliates@aesdr.com
# Group address that workshop reminders fan out to (per-registrant send is
# the real fix — see P1-9). Falls back to hello@aesdr.com if unset.
WORKSHOP_REGISTRANT_GROUP_ADDR=workshops@aesdr.com

# ─── Partner-kit gate (signed-URL token secret) ───
# 32+ random characters. Used to HMAC-sign the per-partner kit access tokens.
# Rotate to invalidate every existing partner access link.
# Generate with: openssl rand -base64 48
KIT_TOKEN_SECRET=replace_with_at_least_32_random_chars

# ─── Site config ───
NEXT_PUBLIC_SITE_URL=https://aesdr.com

# ─── Coming Soon gate (true = redirect all traffic to /coming-soon) ───
# Server-only env var, read at runtime in proxy.ts. Flipping this in
# Vercel takes effect on next request — no redeploy required.
COMING_SOON=false
# Bypass code for the holding page (?bypass=<code> or the ghost button → sets a
# cookie). The code lives ONLY in the env var — never commit a real one here.
# Without it set, the bypass is uncrackable (good for a hard pre-launch lock).
COMING_SOON_BYPASS_CODE=replace_with_a_random_code

# ─── Cron auth (Vercel Cron → route handlers) ───
# Shared secret every /api/cron/* route checks via verifyCronAuth. A fresh
# deploy 500s on every cron until this is set. Generate: openssl rand -hex 32
CRON_SECRET=replace_with_a_random_secret

# ─── Admin / founder access ───
# Comma-separated emails granted founder/admin access (admin dashboards, kit
# minting, refund button). Merged with a hardcoded permanent-admin list.
ADMIN_EMAILS=you@aesdr.com
# Password gate for the founder-only /x/ops affiliate-experience console
# (no login — single shared password). Unset = the console is disabled.
AFFILIATE_OPS_PASSWORD=replace_with_a_random_password

# ─── PII pseudonymization ───
# REQUIRED salt for the HMAC used to hash visitor IPs before storage
# (lib/hash-ip.ts). There is intentionally no default — if unset, ip_hash is
# stored as null rather than a guessable value. Generate: openssl rand -hex 32
IP_HASH_SALT=replace_with_a_random_salt

# ─── Launch flip (pre-launch = false, launch day = true) ───
# Controls robots.txt, <meta robots>, and search indexing.
NEXT_PUBLIC_LAUNCH_MODE=false

# ─── Optional: Upstash Redis (rate limiting) ───
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Optional: Anthropic (AI features, if any) ───
ANTHROPIC_API_KEY=

# ─── Partnership agents (scout / dossier / scribe / contact-finder) ───
# BetterContact email-finder API key. Unset = the contact-finder agent
# silently no-ops (no email lookups, no BetterContact billing).
EMAIL_FINDER_API_KEY=
# Minimum voice-fit score (1–5) a dossier must clear before scribe auto-drafts
# outreach for it. Defaults to 4. A non-numeric value parses to NaN and breaks
# the filter — set a plain integer.
SCRIBE_MIN_VOICE_FIT=4
# Deep-link bases for the operator's own webmail (no mail API, plain URLs).
# Default to Gmail search / compose; override for another webmail.
NEXT_PUBLIC_INBOX_SEARCH_BASE=https://mail.google.com/mail/u/0/#search/
NEXT_PUBLIC_INBOX_COMPOSE_BASE=https://mail.google.com/mail/?view=cm&fs=1&to=

# ─── Optional: Sentry (error monitoring) ───
# DSN values come from Sentry → Project Settings → Client Keys (DSN).
# AUTH_TOKEN is for source-map upload at build time and is build-only.
# When unset, Sentry init is a no-op — the app still works.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── PostHog (product analytics + session replay) ───
# Project API Key from PostHog → Project Settings → Project API Key.
# Host is the ingestion endpoint for your region:
#   US Cloud → https://us.i.posthog.com
#   EU Cloud → https://eu.i.posthog.com
# When NEXT_PUBLIC_POSTHOG_KEY is unset, the PostHog client is a no-op.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
